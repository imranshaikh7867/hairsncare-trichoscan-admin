# The HairsnCares API, including the version segment.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Firebase, the same project every HairsnCares panel signs in to.
#
# These are not secrets. A Firebase web config is shipped inside the client
# bundle by design; what protects the workspace is the backend checking the
# token and looking the account up in the Admin collection.
#
# A Firebase account alone opens nothing. The account also needs an Admin
# record, which is created once with:
#
#   cd ../hairsncares-backend
#   npm run admin:provision -- tricho_admin@hairsncares.com
#
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hairsncares-d489d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hairsncares-d489d
VITE_FIREBASE_STORAGE_BUCKET=hairsncares-d489d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=674982473675
VITE_FIREBASE_APP_ID=
